# --- Required -------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# MongoDB: sites, visitors, conversations, messages and usage live here.
MONGODB_URI=mongodb://localhost:27017/chatbot
# MONGODB_DB=            # only if the database is not named in MONGODB_URI

# Signs the 15-minute chat session tokens. Use a long random value in production.
JWT_SECRET=dev-secret-change-in-production

# --- Admin API ------------------------------------------------------------------------------
# Shared key for /admin/*, sent as the x-admin-key header. Unset = the admin API is OFF.
# (Placeholder auth: the real project replaces it with its login.)
ADMIN_API_KEY=

# --- Same names as the myra-ai API ----------------------------------------------------------
# API_PORT=4000          # also accepts PORT
# CORS_ORIGINS=http://localhost:3000
# TENANT_HEADER=x-tenant-id
# DEFAULT_TENANT_ID=demo-tenant
# ALLOW_DEFAULT_TENANT=true   # false in production: then every /admin request must send a tenant
# NODE_ENV=development        # development/test also seed the demo site st_demo

# --- Answers --------------------------------------------------------------------------------
# gemini: ask Gemini directly. engine: ask the Python engine (POST {ENGINE_URL}/chat).
# ANSWER_PROVIDER=gemini
# ENGINE_URL=http://localhost:8000
# ENGINE_TIMEOUT_MS=15000

# --- Embed snippet generated by the admin API -----------------------------------------------
# WIDGET_PUBLIC_URL=http://localhost:3000   # where widget.js is served
# API_PUBLIC_URL=http://localhost:4000      # where this API is reachable from customers' browsers

# --- Behind a reverse proxy ------------------------------------------------------------------
# TRUST_PROXY=true       # read the visitor's IP from X-Forwarded-For (per-IP limits)
